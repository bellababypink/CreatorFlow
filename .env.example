# Local mode is for development only. Production refuses local accounts.
APP_MODE=local
APP_ORIGIN=http://localhost:5173
PORT=3001
CF_DATA_DIR=.data
# Real Gemini key, server-side only. Never prefix with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MAX_UPLOAD_BYTES=104857600
MAX_VIDEO_DURATION_SECONDS=600
WORKSPACE_STORAGE_QUOTA_BYTES=1073741824
WORKSPACE_MAX_ACTIVE_JOBS=3
# For production set APP_MODE=firebase, NODE_ENV=production, APP_ORIGIN=https://your-domain.
# Use Application Default Credentials or GOOGLE_APPLICATION_CREDENTIALS outside the repo.
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_APP_ID=
